# syntax=docker/dockerfile:1
# Hugging Face Space image. The Space itself holds only this file, its README and a data snapshot;
# the code is fetched at build time from the private GitHub repo with a read-only deploy key
# (Space secret DEPLOY_KEY, base64 encoded), so visitors can use the app without seeing the code.
# deploy/space.py fills in the repo and commit.

FROM alpine:3.20 AS source
RUN apk add --no-cache git openssh-client
ARG REPO={repo}
ARG SHA={sha}
RUN --mount=type=secret,id=DEPLOY_KEY,mode=0444,required=true \
    mkdir -p /root/.ssh && base64 -d /run/secrets/DEPLOY_KEY > /root/.ssh/id_ed25519 && chmod 600 /root/.ssh/id_ed25519 \
    && export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new" \
    && git init -q /src && cd /src && git remote add origin git@github.com:${REPO}.git \
    && git fetch -q --depth 1 origin ${SHA} && git checkout -q FETCH_HEAD \
    && rm -rf /root/.ssh /src/.git

FROM node:20-alpine AS web
WORKDIR /web
COPY --from=source /src/web/package.json /src/web/package-lock.json ./
RUN npm ci
COPY --from=source /src/web/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 app
WORKDIR /app
COPY --from=source /src/pyproject.toml /src/README.md ./
COPY --from=source /src/src ./src
RUN pip install .
COPY --from=source --chown=app /src/models ./models
COPY --chown=app data ./data
COPY --from=web --chown=app /web/out ./web/out
USER app

# stats.nba.com blocks cloud servers: fail fast and rely on cdn.nba.com for the live season.
ENV NBA_DATA_DIR=/app/data NBA_ARTIFACTS_DIR=/app/models NBA_WEB_DIR=/app/web/out \
    NBA_RETRY_ATTEMPTS=1 NBA_REQUEST_TIMEOUT=20 PORT=7860
EXPOSE 7860
CMD ["sh", "-c", "uvicorn nba_predictor.api:create_app --factory --host 0.0.0.0 --port ${PORT}"]
